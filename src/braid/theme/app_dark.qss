/* 由 build_qss.py 从 tokens.json 生成；勿手改 app_light.qss / app_dark.qss */
* { font-size: 13px; color: #ECECEA; outline: none; }
QWidget { background: transparent; border: none; selection-background-color: rgba(217, 119, 87, 68); }
QMainWindow, #ChatArea { background: #1B1B1A; }
#Sidebar { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #222221, stop:0.8 #222221, stop:1 #1E1E1D); }
#SidePanel { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #1E1E1D, stop:0.2 #232322, stop:1 #232322); }
#StatusBar { background: #222221; color: #A3A3A0; font-size: 12px; min-height: 26px; padding: 0 14px; }
QSplitter::handle { background: transparent; width: 6px; }
QSplitter::handle:hover { background: #343433; }
QLabel[role="caption"] { color: #73736F; font-size: 12px; }
QLabel[role="title"] { font-size: 18px; font-weight: 600; }
QLabel[role="secondary"] { color: #A3A3A0; }

QPushButton, QToolButton { background: #30302F; border-radius: 10px; padding: 6px 12px; }
QPushButton:hover, QToolButton:hover { background: #343433; }
QPushButton:pressed, QToolButton:pressed, QToolButton:checked { background: #3A3A39; }
QPushButton:disabled, QToolButton:disabled { color: #73736F; }
QPushButton[variant="primary"] { background: #E6E6E3; color: #1B1B1A; font-weight: 600; }
QPushButton[variant="primary"]:hover { background: #FFFFFF; }
QPushButton[variant="ghost"], QToolButton[variant="ghost"] { background: transparent; color: #A3A3A0; }
QPushButton[variant="ghost"]:hover, QToolButton[variant="ghost"]:hover { background: #343433; color: #ECECEA; }
QPushButton[variant="danger"] { background: transparent; color: #E2685B; }
QPushButton[variant="danger"]:hover { background: #343433; }
#SendButton { background: #E6E6E3; color: #1B1B1A; border-radius: 17px; min-width: 34px; min-height: 34px; padding: 0; }
QToolButton::menu-indicator { image: none; width: 0; }
QToolButton[role="chip"], QLabel[role="chip"] { background: #30302F; border-radius: 12px; padding: 4px 12px; font-size: 12px; }

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QComboBox { background: #343433; border-radius: 12px; padding: 8px 12px; border: 1.5px solid transparent; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #D97757; }
QLineEdit[placeholderText] { color: #ECECEA; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView { background: #2A2A29; border-radius: 10px; padding: 4px; }
#Composer { background: #2A2A29; border-radius: 16px; }
#Composer QPlainTextEdit { background: transparent; padding: 4px; font-size: 14px; border: none; }
QPlainTextEdit[role="textarea"] { background: #2A2A29; }

QListView, QListWidget, QTreeView { background: transparent; }
QListView::item, QListWidget::item, QTreeView::item { border-radius: 10px; padding: 6px 8px; margin: 1px 0; }
QListView::item:hover, QListWidget::item:hover, QTreeView::item:hover { background: #343433; }
QListView::item:selected, QListWidget::item:selected, QTreeView::item:selected { background: #3A3A39; color: #ECECEA; }

QFrame[role="card"], QDialog, #QuickWindow { background: #2A2A29; border-radius: 14px; }
QFrame[role="toolBlock"], QFrame[role="code"] { background: #262625; border-radius: 12px; }
QFrame[role="userBubble"] { background: #2F2F2E; border-radius: 14px; }
QTextBrowser, QTextBrowser[role="markdown"] { background: transparent; font-size: 14px; }

QTabBar::tab { background: transparent; color: #73736F; padding: 4px 8px; margin-right: 2px; border-radius: 8px; }
QTabBar::tab:hover { color: #ECECEA; }
QTabBar::tab:selected { background: #343433; color: #ECECEA; font-weight: 600; }
QTabWidget::pane { border: none; }

QCheckBox::indicator { width: 14px; height: 14px; border-radius: 4px; background: #3A3A39; }
QCheckBox::indicator:checked { background: #E6E6E3; }
QRadioButton::indicator { width: 14px; height: 14px; border-radius: 7px; background: #3A3A39; }
QRadioButton::indicator:checked { background: #E6E6E3; }
QSlider::groove:horizontal { height: 4px; background: #343433; border-radius: 2px; }
QSlider::handle:horizontal { width: 14px; margin: -5px 0; background: #E6E6E3; border-radius: 7px; }

QMenu { background: #2A2A29; border-radius: 12px; padding: 6px; }
QMenu::item { padding: 6px 14px; border-radius: 8px; }
QMenu::item:selected { background: #343433; }
QMenu::separator { height: 6px; background: transparent; }
QToolTip { background: #E6E6E3; color: #1B1B1A; border: none; border-radius: 6px; padding: 4px 8px; }

QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #3A3A39; border-radius: 3px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #73736F; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:horizontal { background: #3A3A39; border-radius: 3px; min-width: 32px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: none; width: 0; height: 0; }

QLabel[status="A"] { color: #5CC28A; font-weight: 600; }
QLabel[status="M"] { color: #E0A54A; font-weight: 600; }
QLabel[status="D"] { color: #E2685B; font-weight: 600; }
QLabel[risk="low"] { color: #5CC28A; } QLabel[risk="medium"] { color: #E0A54A; } QLabel[risk="high"] { color: #E2685B; }

/* —— v1.1：并入 app.py 的 EXTRA_QSS，并修正首轮截图问题 —— */
#ComposerInput { background: transparent; border: none; padding: 4px; font-size: 14px; }
#ChatArea QPushButton[variant="ghost"] { font-size: 14px; }
QTabBar { qproperty-drawBase: 0; }
QTabWidget::tab-bar { border: none; }
#Composer QComboBox, #Composer QToolButton { background: #30302F; border-radius: 10px; padding: 4px 10px; border: none; font-size: 12px; }
#Composer QComboBox:hover, #Composer QToolButton:hover { background: #343433; }
#Composer #SendButton { background: #E6E6E3; color: #1B1B1A; border-radius: 17px; padding: 0; }

/* —— v1.2：骨架截图 vs v3 线稿对照修正 —— */
#SendButton:hover { background: #FFFFFF; }
#SendButton:disabled { background: #3A3A39; color: #73736F; }
#EmptyHint, #PanelPlaceholder { color: #73736F; font-size: 13px; }
#Sidebar QPushButton[variant="secondary"] { padding: 8px 12px; }
#SessionList::item { padding: 7px 10px; }
QTabBar#PanelTabs::tab { padding: 4px 8px; font-size: 13px; }
#ChatArea QPushButton[variant="ghost"] { color: #73736F; border-radius: 8px; }
#ChatArea QPushButton[variant="ghost"]:hover { color: #ECECEA; }
#Composer QComboBox::down-arrow { image: none; width: 0; }
#Composer QComboBox { padding-right: 10px; }

/* —— v1.3：多级菜单（模型 + 推理强度）。${assets} 由 load_qss 在运行时替换为图标目录 —— */
QMenu { background: #2A2A29; border: none; border-radius: 12px; padding: 6px; }
QMenu[rounded="true"] { background: transparent; padding: 24px; qproperty-surfaceColor: "#2A2A29"; }
QMenu::item { color: #ECECEA; padding: 7px 30px 7px 32px; border-radius: 8px; min-width: 150px; font-size: 13px; }
QMenu::item:selected { background: #343433; }
QMenu::item:checked { background: #3A3A39; font-weight: 600; }
QMenu::item:checked:selected { background: #343433; }
QMenu::item:disabled { color: #73736F; background: transparent; font-size: 12px; padding: 8px 12px 3px 12px; }
QMenu::indicator { width: 16px; height: 16px; left: 10px; }
QMenu::indicator:checked { image: url(${assets}/icons/check_dark.png); }
QMenu::right-arrow { image: url(${assets}/icons/chevron_right_dark.png); width: 12px; height: 12px; right: 10px; }
QMenu::separator { height: 1px; margin: 5px 10px; background: transparent; }
QMenu::section { color: #73736F; font-size: 12px; padding: 8px 12px 4px 12px; }
QToolButton[role="modelChip"] { background: #30302F; border-radius: 12px; padding: 4px 34px 4px 12px; font-size: 12px; }
QToolButton[role="modelChip"]:hover, QToolButton[role="modelChip"][popupOpen="true"] { background: #343433; }
QToolButton[role="modelChip"]::menu-indicator { image: none; width: 0px; }

/* 窗口控制按钮（浮层，右上角）：28×28。悬停时代码设 hovered=true 并 repolish，图标色从 palette().buttonText() 读 */
QToolButton[role="windowControl"] { background: transparent; border: none; border-radius: 8px; color: #A3A3A0; min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px; padding: 0; }
QToolButton[role="windowControl"]:hover, QToolButton[role="windowControl"][hovered="true"] { background: #343433; }
QToolButton[role="windowControl"][kind="close"]:hover, QToolButton[role="windowControl"][kind="close"][hovered="true"] { background: #E5484D; color: #FFFFFF; }

/* 设置页：模型与服务 */
#settingsNav { background: transparent; border: none; padding: 8px; }
#settingsNav::item { color: #A3A3A0; padding: 0 12px; min-height: 32px; border-radius: 8px; }
#settingsNav::item:selected { background: #2B2B2A; color: #ECECEA; }
#settingsNav::item:hover:!selected { background: #2B2B2A; }
#settingsTitle { font-size: 18px; color: #ECECEA; }
#settingsSubtitle { font-size: 13px; color: #A3A3A0; }
#settingsEmpty { font-size: 13px; color: #73736F; }
#mcpTarget { color: #73736F; }  /* 字体由 widgets.mono_font() 设置 */
#mcpTarget[error="true"] { color: #E2685B; }
#providerName { font-size: 14px; font-weight: 600; }
#settingLabel { color: #ECECEA; font-weight: normal; }
#settingCardTitle { color: #A3A3A0; font-size: 12px; }
#fieldLabel { color: #A3A3A0; font-size: 12px; }
#fieldUnit { color: #73736F; font-size: 12px; }
#agentName { color: #ECECEA; font-weight: normal; }
#agentDesc { color: #A3A3A0; font-size: 12px; }
#agentModel { color: #73736F; font-size: 12px; }
#agentTag { background: #3A3A39; color: #A3A3A0; font-size: 11px; border-radius: 6px; padding: 0 6px; }
QToolButton#toolChip { background: #30302F; color: #A3A3A0; border: none; border-radius: 12px; padding: 3px 10px; font-size: 12px; }
QToolButton#toolChip:checked { background: #3A3A39; color: #ECECEA; }
QToolButton#toolChip:hover { color: #ECECEA; }
QToolButton#toolChip:checked:hover { background: #3A3A39; }
#agentFieldValue { color: #ECECEA; }
QPlainTextEdit#promptEdit { background: #30302F; border: 1.5px solid transparent; border-radius: 8px; padding: 6px 8px; }
QPlainTextEdit#promptEdit:focus { border-color: #D97757; }
#instructionPath { color: #ECECEA; }
#matchCount { color: #73736F; font-size: 12px; }
QComboBox#settingsCombo { padding-right: 28px; }
QComboBox#settingsCombo::drop-down { width: 0; border: none; }
QComboBox#settingsCombo::down-arrow { image: none; width: 0; height: 0; }
QMenu[role="comboPopup"]::item { padding: 7px 16px 7px 12px; min-width: 0; }
QMenu[role="comboPopup"]::item:checked { background: #2B2B2A; font-weight: normal; }
QMenu[role="comboPopup"]::item:selected { background: #343433; }
QMenu[role="comboPopup"]::indicator { width: 0; height: 0; }
QToolButton#textButton { background: transparent; color: #A3A3A0; border: none; padding: 4px 6px; border-radius: 6px; }
QToolButton#textButton:hover { background: #343433; color: #ECECEA; }
QToolButton#textButton:disabled { color: #73736F; }
#testResult { font-size: 12px; }
QLineEdit#settingsNumber, QLineEdit#settingsInput, QComboBox#settingsCombo { background: #30302F; border: 1.5px solid transparent; border-radius: 8px; padding: 2px 8px; min-height: 24px; }
QLineEdit#settingsNumber:focus, QLineEdit#settingsInput:focus, QComboBox#settingsCombo:focus { border-color: #D97757; }
QLineEdit#settingsField { background: #30302F; border: none; border-radius: 10px; padding: 0 12px; min-height: 36px; }
QLineEdit#settingsField:focus { background: #2A2A29; border: 1px solid rgba(217, 119, 87, 68); }
#keyringWarning { background: rgba(224, 165, 74, 38); color: #E0A54A; border-radius: 8px; padding: 8px 12px; }
QToolButton#keyEye, QToolButton#providerMore { background: transparent; color: #A3A3A0; padding: 0; min-width: 28px; min-height: 28px; }
QToolButton#keyEye:hover, QToolButton#providerMore:hover { background: #343433; }
QMenu[danger="true"]::item { color: #E2685B; }
QMenu[danger="true"]::item:selected { background: rgba(226, 104, 91, 31); }
/* P3 快捷键 */
#keyGroupTitle { color: #73736F; font-size: 11px; }
QLabel#keyChip { background: #30302F; color: #ECECEA; border-radius: 6px; padding: 0 6px; }
#keyCleared { color: #73736F; font-size: 12px; }
QLabel#keyRecord { color: #73736F; font-size: 12px; background: transparent; }
#keyNote { color: #73736F; font-size: 11px; }
#keyConflict { color: #E0A54A; font-size: 12px; }
QToolButton#keyReset { background: transparent; color: #73736F; border: none; padding: 0; font-size: 14px; }
QToolButton#keyReset:hover { color: #ECECEA; }
/* P3 高级 */
#settingDesc, #snapshotNote { color: #A3A3A0; font-size: 12px; }
#settingRow[dim="true"] QLabel#settingLabel, #settingRow[dim="true"] QLabel#fieldUnit { color: #73736F; }
QLineEdit#settingsNumber:disabled { color: #73736F; }
QToolButton#dangerTextButton { background: transparent; color: #E2685B; border: none; padding: 4px 10px; border-radius: 6px; }
QToolButton#dangerTextButton:hover { background: rgba(226, 104, 91, 31); }
QDialog#resetDialog { background: transparent; }
#dialogTitle { color: #ECECEA; }
#dialogDesc { color: #A3A3A0; font-size: 13px; }
QToolButton#dialogCancel { background: #30302F; color: #ECECEA; border: none; border-radius: 8px; padding: 0 14px; }
QToolButton#dialogCancel:hover { background: #343433; }
QToolButton#dangerButton { background: #E2685B; color: #FFFFFF; border: none; border-radius: 8px; padding: 0 14px; }
QDialog#resetDialog QCheckBox::indicator:checked { background: #E2685B; }
/* 模型与服务：钥匙串状态（检查前 text3） */
QLabel#keyringStatus { color: #73736F; font-size: 12px; }
QLabel#keyringStatus[state="ok"] { color: #73736F; }
QLabel#keyringStatus[state="fail"] { color: #E0A54A; }

/* —— v1.4：Windows 真机反馈 7/9/6 —— */
/* 9 输入框：阴影代替边框（亮色另加 1px border_subtle 描边），最大宽度 760 居中 */
#Composer { border-radius: 16px; }
/* 7 底栏图标/文字按钮：平时无底，悬停 hover 浅底，圆角 8 */
#Composer QToolButton[bar="true"], #Composer QPushButton[bar="true"] { background: transparent; border-radius: 8px; color: #A3A3A0; }
#Composer QToolButton[bar="true"]:hover, #Composer QPushButton[bar="true"]:hover { background: #343433; color: #ECECEA; }
/* 6 模型菜单：两行（名称 + text3 12px 说明），选中只靠打勾，灰底只给悬停行 */
QMenu[role="modelMenu"]::item { padding: 6px 30px 24px 32px; min-width: 230px; }
QMenu[role="modelMenu"]::item:checked { background: transparent; font-weight: normal; }
QMenu[role="modelMenu"]::item:selected, QMenu[role="modelMenu"]::item:checked:selected { background: #343433; }
QMenu[role="modelMenu"]::item:disabled { background: transparent; font-size: 12px; padding: 8px 12px 3px 12px; min-width: 0; }
